++"""Finite unordered constraints: independent truth table and live prefix controls."""
++import itertools
++import json
++
++import pytest
++import xgrammar as xgr
++from xgrammar.base import _core
++from xgrammar.structural_tag import ConstStringFormat, SequenceFormat, StructuralTag, TagFormat
++
++
++def tag(names, required=(), minimum=0, maximum=None, dependencies=()):
++    return StructuralTag(format=TagFormat(begin="[", end="]", content=SequenceFormat(
++        unordered=True, elements=[ConstStringFormat(value=name + ";") for name in names],
++        required=[name in required for name in names], min_elements=minimum,
++        max_elements=maximum, dependencies=list(dependencies))))
++
++
++def compile_tag(value, pieces=None, dynamic=False):
++    pieces = pieces or ["x", "[EOS]"]
++    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(pieces, stop_token_ids=len(pieces)-1),
++                                   enable_dynamic_compilation=dynamic)
++    return compiler.compile_structural_tag(value)
++
++
++def accepts(compiled, names):
++    matcher = xgr.GrammarMatcher(compiled)
++    return matcher.accept_string("[" + "".join(name + ";" for name in names) + "]") and matcher.is_completed()
++
++
++@pytest.mark.parametrize("minimum,maximum,required,deps", [
++    (0, 0, (), ()), (0, 2, (), ()), (2, 3, ("c",), ()),
++    (0, None, (), ((0, 1),)), (2, None, (), ((0, 1), (1, 2))),
++    (1, None, ("a",), ((0, 1), (1, 2))),
++    (1, None, (), ((0, 1), (1, 0))),
++])
++def test_independent_exhaustive_permutations(minimum, maximum, required, deps):
++    names = ["c", "a", "b", "d"]  # deliberately not lexical order
++    compiled = compile_tag(tag(names, required, minimum, maximum, deps))
++    for size in range(5):
++        for order in itertools.permutations(names, size):
++            selected = set(order)
++            expected = minimum <= size <= (4 if maximum is None else maximum)
++            expected &= set(required).issubset(selected)
++            expected &= all(names[a] not in selected or names[b] in selected for a, b in deps)
++            assert accepts(compiled, order) == expected, order
++    assert not accepts(compiled, ["a", "a"])
++
++
++def test_capability_and_grammar_roundtrip():
++    assert _core.SupportsUnorderedConstraintsV1()
++    grammar = xgr.Grammar.from_structural_tag(tag(["z", "a", "m"], dependencies=[(0, 1), (1, 2)]))
++    reparsed = xgr.Grammar.from_ebnf(str(grammar))
++    restored = xgr.Grammar.deserialize_json(grammar.serialize_json())
++    with pytest.raises(RuntimeError, match="version|Version"):
++        xgr.Grammar.deserialize_json(grammar.serialize_json().replace(xgr.get_serialization_version(), "v21"))
++    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(["x", "[EOS]"], stop_token_ids=1))
++    for current in [grammar, reparsed, restored]:
++        compiled = compiler.compile_grammar(current)
++        assert accepts(compiled, ["m", "z", "a"])
++        assert not accepts(compiled, ["z", "a"])
++
++
++@pytest.mark.parametrize("dynamic", [False, True])
++def test_masks_rollback_and_no_completion_dead_end(dynamic):
++    names = ["c", "a", "b"]
++    pieces = ["[", "c;", "a;", "b;", "]", "c;a;]", "[EOS]"]
++    compiled = compile_tag(tag(names, minimum=1, dependencies=[(0, 1), (1, 2)]), pieces, dynamic)
++    matcher = xgr.GrammarMatcher(compiled)
++    mask = xgr.allocate_token_bitmask(1, len(pieces))
++    def allowed():
++        matcher.fill_next_token_bitmask(mask)
++        return {i for i in range(len(pieces)) if (int(mask[0, 0]) >> i) & 1}
++    assert matcher.accept_token(0)
++    assert allowed() == {1, 2, 3}
++    assert matcher.accept_token(1)
++    assert allowed() == {2, 3}
++    assert not matcher.accept_token(4)
++    assert matcher.accept_token(3)
++    assert allowed() == {2}
++    matcher.rollback(2)
++    assert allowed() == {1, 2, 3}
++    assert matcher.accept_token(2)
++    assert allowed() == {1, 3}
++    assert matcher.accept_token(3)
++    assert allowed() == {1, 4}
++    assert matcher.accept_token(4)
++    assert matcher.is_completed()
++    matcher.reset()
++    assert allowed() == {0}
++
