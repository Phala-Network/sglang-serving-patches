++"""Native V2 masks checked against independent finite JSON Schema supersets."""
++import itertools
++import json
++
++import pytest
++from jsonschema import Draft202012Validator
++import xgrammar as xgr
++from xgrammar.base import _core
++from xgrammar.structural_tag import ConstStringFormat, SequenceFormat, StructuralTag, TagFormat
++
++
++def native(names, group, mode, dependencies=(), required=(), minimum=0):
++    return StructuralTag(format=TagFormat(begin="[", end="]", content=SequenceFormat(
++        elements=[ConstStringFormat(value=key + ";") for key in names], unordered=True,
++        required=[i in required for i in range(len(names))], min_elements=minimum,
++        dependencies=list(dependencies), presence_mode=mode, presence_indices=list(group))))
++
++
++@pytest.mark.parametrize("dynamic", [False, True])
++def test_exhaustive_prefix_and_close_oracle(dynamic):
++    names = ["d", "a", "c", "b"]
++    pieces = ["["] + [key + ";" for key in names] + ["]", "[EOS]"]
++    info = xgr.TokenizerInfo(pieces, stop_token_ids=6)
++    compiler = xgr.GrammarCompiler(info, max_threads=1, cache_enabled=False, enable_dynamic_compilation=dynamic)
++    for mode, edges, reqbits, minimum, group in itertools.product(
++        ["not_all", "exactly_one"], [[], [(0, 1), (1, 2)], [(0, 1), (1, 0)]],
++        [0, 1, 3], [0, 1, 3, 4], [[0], [0, 1], [0, 1, 2, 3]],
++    ):
++        required = [i for i in range(4) if reqbits & (1 << i)]
++        schema = {"type": "object", "properties": dict.fromkeys(names, True), "additionalProperties": False,
++                  "required": [names[i] for i in required], "minProperties": minimum,
++                  "dependentRequired": {names[i]: [names[j] for a, j in edges if a == i] for i, _ in edges}}
++        if mode == "not_all":
++            schema["not"] = {"required": [names[i] for i in group]}
++        else:
++            schema["oneOf"] = [{"required": [names[i]]} for i in group]
++        validator = Draft202012Validator(schema)
++        valid = [mask for mask in range(16) if validator.is_valid({names[i]: 0 for i in range(4) if mask & (1 << i)})]
++        fmt = native(names, group, mode, edges, required, minimum)
++        if not valid:
++            with pytest.raises(RuntimeError, match="presence_unsatisfiable"):
++                compiler.compile_structural_tag(fmt)
++            continue
++        compiled = compiler.compile_structural_tag(fmt)
++        for selected in range(16):
++            matcher = xgr.GrammarMatcher(compiled)
++            assert matcher.accept_token(0)
++            accepted = all(matcher.accept_token(i + 1) for i in reversed(range(4)) if selected & (1 << i))
++            feasible = any(selected & ~full == 0 for full in valid)
++            assert accepted == feasible, (mode, edges, reqbits, minimum, group, selected)
++            if not feasible:
++                continue
++            mask = xgr.allocate_token_bitmask(1, 7)
++            matcher.fill_next_token_bitmask(mask)
++            actual = {i for i in range(7) if (int(mask[0, 0]) >> i) & 1}
++            expected = {i + 1 for i in range(4) if not selected & (1 << i)
++                        and any((selected | (1 << i)) & ~full == 0 for full in valid)}
++            if selected in valid:
++                expected.add(5)
++            assert actual == expected, (mode, selected, actual, expected)
++            assert matcher.accept_token(5) == (selected in valid)
++
++
