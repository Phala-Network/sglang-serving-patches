++        "again": {"$ref": "#/$defs/node"}, "target": {"$ref": "#/$defs/forbidden"}}}
++    schema, source = priority_case(keyword, {"$ref": "#/$defs/node"},
++        value={"c": {"target": {"z": 1}}},
++        definitions={"node": node, "forbidden": FORBIDDEN})
++    assert not Draft202012Validator(schema).is_valid(json.loads(source))
++    require_unsupported(schema, keyword)
++
