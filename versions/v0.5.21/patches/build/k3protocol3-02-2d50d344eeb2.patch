++@pytest.mark.parametrize("dynamic", [False, True])
++def test_rollback_and_cross_boundary_tokens(dynamic):
++    pieces = ["[", "a;", "b;", "c;", "]", "a;b;", "c;b;]", "[EOS]"]
++    fmt = native(["a", "b", "c"], [0, 1], "exactly_one", [(2, 1)])
++    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(pieces, stop_token_ids=7), enable_dynamic_compilation=dynamic)
++    matcher = xgr.GrammarMatcher(compiler.compile_structural_tag(fmt))
++    assert matcher.accept_token(0)
++    mask = xgr.allocate_token_bitmask(1, len(pieces))
++    matcher.fill_next_token_bitmask(mask)
++    assert not (int(mask[0, 0]) >> 5) & 1
++    assert (int(mask[0, 0]) >> 6) & 1
++    assert matcher.accept_token(1)
++    assert not matcher.accept_token(3)
++    matcher.rollback(1)
++    assert matcher.accept_token(3)
++    matcher.fill_next_token_bitmask(mask)
++    assert {i for i in range(8) if (int(mask[0, 0]) >> i) & 1} == {2}
++    assert matcher.accept_token(2) and matcher.accept_token(4)
++    matcher.reset()
++    assert matcher.accept_token(0) and matcher.accept_token(6)
