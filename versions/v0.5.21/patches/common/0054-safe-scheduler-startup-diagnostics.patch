diff --git a/python/sglang/srt/utils/startup_diagnostics.py b/python/sglang/srt/utils/startup_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..a70d8885564c6a7e670d1d401a06e8dcade90596
--- /dev/null
+++ b/python/sglang/srt/utils/startup_diagnostics.py
@@ -0,0 +1,53 @@
+"""Bounded fatal-worker diagnostics without traceback locals or request data."""
+
+import json
+import os
+from pathlib import Path
+import re
+
+_CREDENTIAL_ENVS = (
+    "TOKEN", "SGLANG_API_KEY", "SGLANG_ADMIN_API_KEY", "HF_TOKEN",
+    "HUGGING_FACE_HUB_TOKEN", "PHALA_CLOUD_API_KEY",
+)
+
+
+def scheduler_exception_diagnostic(error, *, startup, credentials=()):
+    """Only constructor failures may include a scrubbed exception message.
+
+    The event loop can carry private prompts/IDs in exception messages. Its
+    diagnostic records type and code locations only. Neither phase emits
+    frame locals, source lines, ServerArgs, request objects or environment.
+    """
+    secrets = [value for value in credentials if isinstance(value, str) and value]
+    secrets.extend(os.environ[name] for name in _CREDENTIAL_ENVS if os.environ.get(name))
+
+    def scrub(value):
+        for secret in sorted(set(secrets), key=len, reverse=True):
+            value = value.replace(secret, "<redacted>")
+        return re.sub(r"(?i)\bbearer\s+[^\s,;'\"]+", "Bearer <redacted>", value)
+
+    frames = []
+    tb = error.__traceback__
+    while tb is not None:
+        code = tb.tb_frame.f_code
+        # Paths identify code, never local variables or the source line.
+        filename = code.co_filename.replace("\\", "/")
+        filename = (
+            "sglang/" + filename.rsplit("/sglang/", 1)[1]
+            if "/sglang/" in filename else Path(filename).name
+        )
+        frames.append({"file": filename, "line": tb.tb_lineno, "function": code.co_name})
+        tb = tb.tb_next
+    diagnostic = {
+        "phase": "startup" if startup else "event_loop",
+        "exception_type": type(error).__module__ + "." + type(error).__name__,
+        "frames": frames[-24:],
+    }
+    if startup:
+        try:
+            message = scrub(str(error))
+        except Exception:
+            message = "<message unavailable>"
+        diagnostic["message"] = message[:1024]
+    # Also remove an exact credential from unusual code filenames/class names.
+    return scrub(json.dumps(diagnostic, ensure_ascii=True, separators=(",", ":")))
diff --git a/test/registered/unit/utils/test_startup_failure_diagnostics.py b/test/registered/unit/utils/test_startup_failure_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..757fd0b9402a005c0d6a8cd776b14bbe194d64ad
--- /dev/null
+++ b/test/registered/unit/utils/test_startup_failure_diagnostics.py
@@ -0,0 +1,48 @@
+"""Fatal load errors remain diagnosable while credentials/locals stay private."""
+
+import json
+import logging
+
+from sglang.srt.utils.framework_log_privacy import FrameworkPrivacyFilter
+from sglang.srt.utils.startup_diagnostics import scheduler_exception_diagnostic
+
+
+def fail_loader(message):
+    private_prompt = "PRIVATE_FRAME_LOCAL_SENTINEL"
+    raise RuntimeError(message)
+
+
+def test_startup_keeps_failure_shape_and_code_locations_but_scrubs_secrets(monkeypatch):
+    secret = "synthetic-token-12345678901234567890"
+    api_key = "synthetic-api-09876543210987654321"
+    monkeypatch.setenv("TOKEN", secret)
+    try:
+        fail_loader(f"expected shape (4, 3584), got (1, 3584); {secret}; {api_key}; Bearer other-credential")
+    except RuntimeError as error:
+        rendered = scheduler_exception_diagnostic(error, startup=True, credentials=(api_key,))
+    assert secret not in rendered and api_key not in rendered
+    assert "other-credential" not in rendered and "PRIVATE_FRAME_LOCAL_SENTINEL" not in rendered
+    diagnostic = json.loads(rendered)
+    assert diagnostic["exception_type"] == "builtins.RuntimeError"
+    assert "expected shape (4, 3584), got (1, 3584)" in diagnostic["message"]
+    assert diagnostic["frames"][-1]["function"] == "fail_loader"
+    assert diagnostic["frames"][-1]["line"] > 0
+    assert set(diagnostic["frames"][-1]) == {"file", "line", "function"}
+
+
+def test_event_loop_omits_private_message_and_oversized_startup_is_bounded():
+    try:
+        fail_loader("PRIVATE_REQUEST_TEXT_SENTINEL" * 1000)
+    except RuntimeError as error:
+        runtime = json.loads(scheduler_exception_diagnostic(error, startup=False))
+        startup = json.loads(scheduler_exception_diagnostic(error, startup=True))
+    assert "message" not in runtime
+    assert "PRIVATE_REQUEST_TEXT_SENTINEL" not in json.dumps(runtime)
+    assert len(startup["message"]) == 1024
+
+
+def test_framework_privacy_does_not_mask_safe_worker_diagnostics():
+    record = logging.LogRecord("sglang.srt.managers.scheduler", logging.ERROR, __file__, 1,
+                               "SCHEDULER_FAILURE %s", ('{"exception_type":"builtins.KeyError"}',), None)
+    assert FrameworkPrivacyFilter().filter(record)
+    assert "builtins.KeyError" in record.getMessage()
