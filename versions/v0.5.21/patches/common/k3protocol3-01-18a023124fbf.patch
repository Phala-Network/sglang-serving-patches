+
+    def test_nonlocal_and_dynamic_fail(self):
+        for node in [{"$ref": "remote.json"}, {"$ref": "#anchor"}, {"$ref": "#/missing"},
+                     {"$dynamicRef": "#"}, {"$schema": "https://json-schema.org/draft/2019-09/schema", "$recursiveRef": "#"}, {"$ref": "#%FF"}]:
