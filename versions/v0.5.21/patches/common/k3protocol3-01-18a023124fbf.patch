+    def test_legacy_ref_siblings_are_ignored_but_modern_are_preserved(self):
+        from jsonschema import (
+            Draft6Validator,
+            Draft7Validator,
+            Draft201909Validator,
+            Draft202012Validator,
+        )
+
+        for declaration, validator in zip(
+            DECLARATIONS,
+            (
+                Draft6Validator,
+                Draft7Validator,
+                Draft201909Validator,
+                Draft202012Validator,
