+    print(
+        json.dumps(
+            {
+                "status": report["status"],
+                "files": len(rows),
+                "expressions": sum(len(row["changes"]) for row in rows),
+                "failures": failures,
+                "applied": report["applied"],
+            },
+            indent=2,
+        )
+    )
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
