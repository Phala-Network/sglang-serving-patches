+                detector = FunctionCallParser(tools, name)
+                fragments = []
+                for offset in range(0, len(text), size):
+                    _, pieces = detector.parse_stream_chunk(
+                        text[offset : offset + size]
+                    )
+                    fragments.extend(pieces)
