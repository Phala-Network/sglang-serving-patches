+    def test_64_slots_c8_pinned_cache_defers_and_recovers(self):
+        from array import array
+
+        import test_mamba_checkpoint_pressure as checkpoint_tests
+
+        from sglang.srt.mem_cache.base_prefix_cache import EvictParams, InsertParams
+        from sglang.srt.mem_cache.radix_cache import RadixKey
+
+        fixture = checkpoint_tests.TestMambaCheckpointPressure()
+        cache, allocator, pool = fixture.fixture(size=64)
+        active = [_req(str(i)) for i in range(7)]
+        self.assertIsNotNone(pool.alloc(active))
+        pins = []
+        for i in range(41):
+            node = cache.insert(
+                InsertParams(
+                    key=RadixKey(array("q", range(i * 100, i * 100 + 64))),
+                    value=allocator.alloc(64),
+                    mamba_value=pool.mamba_allocator.alloc(1),
+                )
+            ).last_device_node
+            receipt = cache.inc_lock_ref(node).to_dec_params()
+            cache._track_write_through_node(node, receipt, [node])
+            pins.append(node)
+        self.assertEqual(pool.mamba_allocator.available_size(), 2)
+        self.assertEqual(cache.mamba_evictable_size(), 0)
+        fresh = _req("eighth")
+        fresh.session = None
+        fresh.to_finish = None
+        scheduler = _scheduler(pool, cache)
+        self.assertFalse(Scheduler._ensure_mamba_admission_capacity(scheduler, fresh, []))
+        free_rows = list(pool.free_slots)
+        free_ids = pool.mamba_allocator.free_slots.clone()
+        self.assertIsNone(pool.alloc([fresh]))
+        self.assertEqual(pool.free_slots, free_rows)
+        torch.testing.assert_close(pool.mamba_allocator.free_slots, free_ids)
+        self.assertIsNone(fresh.kv.req_pool_idx)
+        self.assertIsNone(fresh.kv.mamba_pool_idx)
+        self.assertIsNone(fresh.kv.mamba_ping_pong_track_buffer)
+        cache._finish_write_through_ack(pins.pop())
+        self.assertTrue(Scheduler._ensure_mamba_admission_capacity(scheduler, fresh, []))
+        self.assertIsNotNone(pool.alloc([fresh]))
+        for req in active + [fresh]:
+            pool.free_mamba_cache(req)
+            pool.free(req)
+        for node in pins:
+            cache._finish_write_through_ack(node)
+        cache.evict_for_alloc(EvictParams(num_tokens=4096, mamba_num=64))
+        ids = pool.mamba_allocator.free_slots.tolist()
+        self.assertEqual(len(ids), 64)
+        self.assertEqual(len(set(ids)), 64)
+        self.assertEqual(allocator.available_size(), 4096)
+
+    def test_selected_cow_and_loadback_states_retain_ping_pong_budget(self):
