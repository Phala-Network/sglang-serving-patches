+                        content={"meta_info": {"id": "chatcmpl-test"}},
+                        request=req,
+                        has_tool_calls=has_tool_calls,
+                    )
+                ]
+
+            chunks = get_or_create_event_loop().run_until_complete(collect_chunks())
