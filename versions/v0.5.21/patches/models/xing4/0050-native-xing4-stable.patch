diff --git a/docker/xing4/README.md b/docker/xing4/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..ae479e940d8965ac90811b7a2bbf4ca5b224c84d
--- /dev/null
+++ b/docker/xing4/README.md
@@ -0,0 +1,24 @@
+# Xing4.0 on stable SGLang
+
+This image delta extends the maintained official v0.5.21 runtime with Xing4.0
+MLA, MoE, mHC and protocol support from upstream PR39793 at
+`aa737beda5878755dffe40836de014663ca2a106`. The source is based on the published
+`phala-v0.5.21-7` compatibility line. Native dependencies are unchanged.
+
+Build on the authorized CPU builder, from a clean committed source checkout:
+
+```bash
+python docker/xing4/prepare_context.py ../xing4-context
+docker build -f ../xing4-context/docker/xing4/Dockerfile \
+  --build-arg ENGINE_COMMIT="$(git rev-parse HEAD)" \
+  --build-arg PATCHES_COMMIT=<ordered-patch-commit> \
+  --build-arg RELEASE_VERSION=<immutable-version> \
+  -t ghcr.io/phala-network/sglang:<immutable-version> ../xing4-context
+```
+
+All executable source is installed during the build. GPU qualification uses the
+image identity without source mounts or startup installation. Direct `hf --help`,
+`hf download --help` and `sglang serve --help` are required final-image checks.
+The focused CPU checks are in `test/registered/unit/models/test_xing4_native.py`;
+CUDA attention, TileLang, real checkpoint loading, FP8 storage and model quality
+still require scoped B300 qualification. No embedded Governor is selected.
diff --git a/docker/xing4/install_source.py b/docker/xing4/install_source.py
new file mode 100644
index 0000000000000000000000000000000000000000..11014e091bbe26d65ac581315dd7f127d674b27a
--- /dev/null
+++ b/docker/xing4/install_source.py
@@ -0,0 +1,59 @@
+"""Install the frozen engine delta at build time and preserve wheel RECORD."""
+
+import base64
+import csv
+import hashlib
+import importlib.metadata
+import io
+import json
+from pathlib import Path
+import shutil
+
+import sglang
+
+
+root = Path(__file__).resolve().parents[2]
+manifest = json.loads((root / "source-manifest.json").read_text())
+installed = Path(sglang.__file__).resolve().parent
+if len(manifest["engine_commit"]) != 40:
+    raise RuntimeError("A full engine commit is required")
+if installed == (root / "python/sglang").resolve():
+    raise RuntimeError("Build source masks the installed package")
+
+copied = {}
+for name, expected in manifest["runtime_sha256"].items():
+    source = root / name
+    if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
+        raise RuntimeError(f"Source mismatch: {name}")
+    relative = Path(name).relative_to("python/sglang")
+    target = installed / relative
+    target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(source, target)
+    if hashlib.sha256(target.read_bytes()).hexdigest() != expected:
+        raise RuntimeError(f"Installed mismatch: {name}")
+    copied[f"sglang/{relative.as_posix()}"] = target
+
+if not copied:
+    raise RuntimeError("The frozen engine delta is empty")
+distribution = importlib.metadata.distribution("sglang")
+record = next(distribution.locate_file(file) for file in distribution.files
+              if file.name == "RECORD" and ".dist-info" in str(file))
+rows = list(csv.reader(io.StringIO(record.read_text())))
+existing = {row[0]: row for row in rows}
+for name, target in copied.items():
+    checksum = base64.urlsafe_b64encode(hashlib.sha256(target.read_bytes()).digest())
+    row = [name, "sha256=" + checksum.decode().rstrip("="), str(target.stat().st_size)]
+    if name in existing:
+        existing[name][:] = row
+    else:
+        rows.append(row)
+with record.open("w", newline="") as stream:
+    csv.writer(stream, lineterminator="\n").writerows(rows)
+
+(root / "installed-source.json").write_text(json.dumps({
+    "engine_commit": manifest["engine_commit"],
+    "base_engine_commit": manifest["base_engine_commit"],
+    "installed_package": str(installed),
+    "runtime_sha256": manifest["runtime_sha256"],
+    "source_overlay": False,
+}, indent=2) + "\n")
diff --git a/docker/xing4/prepare_context.py b/docker/xing4/prepare_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2e003aded3bd85b3925be6fbdf0d503b2484d8c
--- /dev/null
+++ b/docker/xing4/prepare_context.py
@@ -0,0 +1,30 @@
+"""Export committed engine bytes for the source-bound Xing image recipe."""
+
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+BASE = "c2ce5382dad45fd85e39f5d4e1d93165225eb34d"
+repo = Path(__file__).resolve().parents[2]
+out = Path(sys.argv[1]).resolve()
+commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()
+subprocess.run(["git", "merge-base", "--is-ancestor", BASE, commit], cwd=repo, check=True)
+changed = subprocess.check_output(["git", "diff", "--name-only", BASE, commit],
+                                  cwd=repo, text=True).splitlines()
+runtime = [name for name in changed if name.startswith("python/sglang/")]
+inputs = set(runtime + ["LICENSE", "docker/xing4/Dockerfile",
+                        "docker/xing4/install_source.py"])
+inputs.update(name for name in changed if name.startswith("test/registered/unit/"))
+manifest = {"engine_commit": commit, "base_engine_commit": BASE, "runtime_sha256": {}}
+for name in sorted(inputs):
+    blob = subprocess.check_output(["git", "show", f"{commit}:{name}"], cwd=repo)
+    path = out / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(blob)
+    if name in runtime:
+        manifest["runtime_sha256"][name] = hashlib.sha256(blob).hexdigest()
+out.mkdir(parents=True, exist_ok=True)
+(out / "source-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+print(json.dumps({"engine_commit": commit, "context": str(out), "modules": len(runtime)}))
