From b0a9011be2759f7a9dbab46e5c070a0119269577 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 13 Oct 2026 15:52:42 +0800
Subject: [PATCH] Limit transient GGUF dense GEMM to large prefill batches

---
 python/sglang/srt/layers/quantization/gguf.py | 12 +++++
 test/manual/gguf_q8_prefill_functional.py     | 38 +++++++++++++++
 .../unit/test_gguf_prefill_dispatch_cpu.py    | 46 +++++++++++++++++++
 3 files changed, 96 insertions(+)
 create mode 100644 test/manual/gguf_q8_prefill_functional.py
 create mode 100644 test/manual/unit/test_gguf_prefill_dispatch_cpu.py

diff --git a/python/sglang/srt/layers/quantization/gguf.py b/python/sglang/srt/layers/quantization/gguf.py
index 1d8b4ba3b..f20f6880b 100644
--- a/python/sglang/srt/layers/quantization/gguf.py
+++ b/python/sglang/srt/layers/quantization/gguf.py
@@ -178,6 +178,10 @@ IMATRIX_QUANT_TYPES = {
 DEQUANT_TYPES = STANDARD_QUANT_TYPES | KQUANT_TYPES | IMATRIX_QUANT_TYPES
 MMVQ_QUANT_TYPES = STANDARD_QUANT_TYPES | KQUANT_TYPES | IMATRIX_QUANT_TYPES
 MMQ_QUANT_TYPES = STANDARD_QUANT_TYPES | KQUANT_TYPES
+# Upstream PR43626 (fdae9010): transient dense GEMM for large batches.
+# Keep short prefill on its original numerical path; expanded weights are not cached.
+DEQUANT_MIN_ROWS = 1024
+DEQUANT_MIN_WORK = 1 << 29
 
 
 def dequantize_gguf_weight(
@@ -206,6 +210,14 @@ def fused_mul_mat_gguf(
     # enable MMVQ in contiguous batching with batch_size=1
     if x.shape[0] <= mmvq_safe and qweight_type in MMVQ_QUANT_TYPES:
         y = ggml_mul_mat_vec_a8(qweight, x, qweight_type, qweight.shape[0])
+    # Large batches: transient dequantization and dense GEMM (upstream PR43626).
+    elif (
+        x.shape[0] >= DEQUANT_MIN_ROWS
+        and x.shape[0] * qweight.shape[0] * x.shape[1] >= DEQUANT_MIN_WORK
+        and qweight_type in DEQUANT_TYPES
+    ):
+        weight = dequantize_gguf_weight(qweight, qweight_type, x.dtype)
+        y = x @ weight.T
     # Use MMQ Kernel if it's available (standard + k-quants)
     elif qweight_type in MMQ_QUANT_TYPES:
         y = ggml_mul_mat_a8(qweight, x, qweight_type, qweight.shape[0])
diff --git a/test/manual/gguf_q8_prefill_functional.py b/test/manual/gguf_q8_prefill_functional.py
new file mode 100644
index 000000000..594420650
--- /dev/null
+++ b/test/manual/gguf_q8_prefill_functional.py
@@ -0,0 +1,38 @@
+"""One-shot exact-GGUF slice numerical check; no timings or serving load.
+Run only on an idle authorized GPU in an isolated container.
+"""
+import argparse,ast,json,pathlib
+import gguf,numpy as np,torch
+import sglang.srt.layers.quantization.gguf as installed
+torch.backends.cuda.matmul.allow_tf32=False
+p=argparse.ArgumentParser();p.add_argument("--gguf",required=True);p.add_argument("--source",required=True);a=p.parse_args()
+source=pathlib.Path(a.source);tree=ast.parse(source.read_text())
+nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=="fused_mul_mat_gguf" or isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id in {"DEQUANT_MIN_ROWS","DEQUANT_MIN_WORK"} for t in n.targets)]
+ns=dict(vars(installed));exec(compile(ast.Module(body=nodes,type_ignores=[]),str(source),"exec"),ns);candidate=ns["fused_mul_mat_gguf"]
+reader=gguf.GGUFReader(a.gguf);tensor=next(t for t in reader.tensors if t.name.startswith("blk.0.") and "ffn_gate.weight" in t.name and int(t.tensor_type)==8)
+assert int(tensor.shape[0])==5120 and int(tensor.shape[1])>=512
+packed=np.array(tensor.data[:512],copy=True);w=torch.from_numpy(packed).to("cuda")
+assert w.ndim==2 and w.shape[0]==512
+rng=torch.Generator(device="cuda");rng.manual_seed(8948)
+x=torch.randn((1024,5120),generator=rng,device="cuda",dtype=torch.bfloat16)
+# Dispatch uses actual installed kernels; source candidate does not modify installed module.
+calls=[];orig_dq=ns["dequantize_gguf_weight"];orig_vec=ns["ggml_mul_mat_vec_a8"]
+def dq(*args):calls.append("dequant");return orig_dq(*args)
+def vec(*args):calls.append("mmvq");return orig_vec(*args)
+ns["dequantize_gguf_weight"]=dq;ns["ggml_mul_mat_vec_a8"]=vec
+with torch.inference_mode():
+ y=candidate(x,w,8);assert calls==["dequant"],calls
+ baseline=installed.ggml_mul_mat_a8(w,x,8,w.shape[0])
+ block,byte=gguf.GGML_QUANT_SIZES[8]
+ wf=installed.ggml_dequantize(w,8,w.shape[0],w.shape[1]//byte*block,torch.float32)
+ reference=x.float()@wf.T
+ def metrics(v):
+  delta=v.float()-reference
+  assert torch.isfinite(v).all()
+  return {"max_abs":delta.abs().max().item(),"relative_l2":(delta.norm()/reference.norm()).item()}
+ result={"dense":metrics(y),"mmq":metrics(baseline)}
+ # Broad screen against gross corruption, not full-model accuracy acceptance.
+ assert result["dense"]["relative_l2"]<0.02 and result["mmq"]["relative_l2"]<0.02,result
+ calls.clear();one=candidate(x[:1],w,8);expected=orig_vec(w,x[:1],8,w.shape[0]);assert calls==["mmvq"] and torch.equal(one,expected)
+ result.update({"tensor":tensor.name,"qtype":8,"slice_weight_shape":[512,5120],"input_shape":[1024,5120],"single_token_original_mmvq_bit_equal":True,"scope":"single real-weight slice numerical functional check; no timing or full-model qualification"})
+ print(json.dumps(result,indent=2))
diff --git a/test/manual/unit/test_gguf_prefill_dispatch_cpu.py b/test/manual/unit/test_gguf_prefill_dispatch_cpu.py
new file mode 100644
index 000000000..e3362a573
--- /dev/null
+++ b/test/manual/unit/test_gguf_prefill_dispatch_cpu.py
@@ -0,0 +1,46 @@
+"""Execute actual source dispatch with sentinel kernel calls; no tensor/kernel correctness claim."""
+import ast,json,pathlib
+class Tensor:
+ def __init__(self,shape):self.shape=shape;self.dtype="bf16";self.device="cpu"
+ @property
+ def T(self):return self
+ def __matmul__(self,other):return "dense"
+class Torch:
+ @staticmethod
+ def empty(*a,**kw):return "empty"
+def load(path):
+ tree=ast.parse(path.read_text(encoding="utf-8"));node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=="fused_mul_mat_gguf")
+ ns={"torch":Torch,"IMATRIX_QUANT_TYPES":{16},"UNQUANTIZED_TYPES":{0,1,30},"MMVQ_QUANT_TYPES":{8,12,16},"MMQ_QUANT_TYPES":{8,12},"DEQUANT_TYPES":{8,12,16},"ggml_mul_mat_vec_a8":lambda *a:"mmvq","ggml_mul_mat_a8":lambda *a:"mmq","dequantize_gguf_weight":lambda *a:Tensor((1,1)),"WeightType":lambda x:x}
+ node.returns=None
+ for a in node.args.args:a.annotation=None
+ for n in tree.body:
+  if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id in {"DEQUANT_MIN_ROWS","DEQUANT_MIN_WORK"} for t in n.targets):
+   exec(compile(ast.Module(body=[n],type_ignores=[]),str(path),"exec"),ns)
+ exec(compile(ast.fix_missing_locations(ast.Module(body=[node],type_ignores=[])),str(path),"exec"),ns);return ns[node.name]
+p=pathlib.Path(__file__).resolve().parents[3]/"python/sglang/srt/layers/quantization/gguf.py";c=load(p)
+cases=[
+ (0,17408,5120,8,"empty"),
+ (1,17408,5120,8,"mmvq"),
+ (2,248320,5120,8,"mmvq"),
+ (47,17408,5120,8,"mmq"),
+ (48,17408,5120,8,"mmq"),
+ (511,1024,1024,8,"mmq"),
+ (512,1024,1024,8,"mmq"),
+ # Row threshold, with work already above the minimum on both sides.
+ (1023,17408,5120,8,"mmq"),
+ (1024,17408,5120,8,"dense"),
+ # Work immediately below and equal to 2**29, with rows at the threshold.
+ (1024,1023,512,8,"mmq"),
+ (1024,1024,512,8,"dense"),
+ (16384,17408,5120,8,"dense"),
+ (16384,17408,5120,30,"dense"),
+ (16,1024,1024,16,"mmvq"),
+ (17,1024,1024,16,"dense"),
+ (48,17408,5120,12,"mmq"),
+]
+results=[]
+for rows,out,inner,q,expected_c in cases:
+ x,w=Tensor((rows,inner)),Tensor((out,inner));actual_c=c(x,w,q)
+ assert actual_c==expected_c,(rows,out,inner,q,actual_c)
+ results.append({"rows":rows,"out":out,"in":inner,"qtype":q,"candidate":actual_c})
+print(json.dumps({"passed":len(results),"scope":"actual-source CPU dispatch only, no numeric or performance proof","cases":results},indent=2))
