+# SGLang 0.5.21 watchdog and DSPARK repair
+
+This maintenance release extends accepted source `53c8f4e63f11887a398b727dd6bc30dbe4aad73c`
+and image `sha256:9619a8004cbeda15ce999ab89d96b1e89b5476bd0507936253876621cc616f9e`.
+It retains all other runtime bytes, native libraries, dependencies and serving parameters.
+The existing frozen 0.5.21 compatibility line remains the release input; current
+unified main is a separate composition.
+
+The common fix preserves SGLang's SIGQUIT ownership under Uvicorn 0.54's
+multi-worker supervisor. Every spawned HTTP worker reads the same terminal
+failure latch. A hard scheduler timeout or child crash publishes failure before
+signaling cleanup; `/ready` and `/health` fail closed across workers. Idle time
+does not count toward the active scheduler deadline. Hard timeouts prioritize
+bounded termination over potentially blocking in-process diagnostics; soft
+watchdogs retain their diagnostic behavior. If the parent ignores SIGQUIT or
+exits without cleanup, the watchdog kills the saved process identities and exits
+itself. A parent already gone before detection cannot be walked retrospectively;
+the failed scheduler still exits. Host/container supervision owns any earlier
+orphaned processes.
+
+The DSPARK fix copies six accept results out of reusable graph buffers before
+the scheduler's asynchronous consumer can race the next graph replay. It follows
+upstream [PR #42812](https://github.com/sgl-project/sglang/pull/42812), head
+`7a8f74963c9db8e21c98ac72cb65ba7b189e6f9c` (open at review). Result values,
+shape, dtype and device remain unchanged. This is a demonstrated buffer-ownership
+defect; the original USW5 stall's unique initiating operation is not established.
+
+Stage from a clean frozen checkout with `prepare_build.py --source-repo REPO
+--patches-commit SHA --output NEW_DIRECTORY`, then build that context once on
+CPU201. The recipe verifies accepted base bytes and installs only ten reviewed
+Python modules. Source tag and a published GitHub Release must exist before
+registry publication. The release receipt binds the final image digest to the
+source and patch commits.
+
+Relevant tests are `utils/test_engine_failure.py`,
+`utils/test_engine_failure_multiprocess.py` with its real four-worker fixture,
+and `spec/test_dspark_accept_result_ownership.py` under `test/registered/unit`.
+Run the final image without runtime-source overlays, including direct HF and
+SGLang CLI checks. CPU/PyTorch storage tests are distinct from the optional CUDA
+stream test and target GPU acceptance.
+
+The repair makes a fatal engine unready and exits its failed processes. It does
+not add automatic container restart; production's existing finite startup owner
+and `restart: no` remain authoritative. PIG/ingress propagation and real model
+acceptance must be checked independently on the authorized target.
diff --git a/docker/phala-watchdog-20261016/prepare_build.py b/docker/phala-watchdog-20261016/prepare_build.py
new file mode 100644
index 000000000..77329c274
--- /dev/null
+++ b/docker/phala-watchdog-20261016/prepare_build.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Stage a small immutable overlay on the accepted 0.5.21 runtime image."""
+
+import argparse
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+BASE_IMAGE = "ghcr.io/phala-network/sglang:0.5.21-phala-offload-fix-20261012@sha256:9619a8004cbeda15ce999ab89d96b1e89b5476bd0507936253876621cc616f9e"
+BASE_SOURCE = "53c8f4e63f11887a398b727dd6bc30dbe4aad73c"
+VERSION = "0.5.21-phala-watchdog-dspark-fix-20261016"
+RUNTIME_FILES = (
+    "python/sglang/srt/entrypoints/engine.py",
+    "python/sglang/srt/entrypoints/http_server.py",
+    "python/sglang/srt/managers/scheduler.py",
+    "python/sglang/srt/managers/scheduler_components/invariant_checker.py",
+    "python/sglang/srt/managers/tokenizer_manager.py",
+    "python/sglang/srt/server_args.py",
+    "python/sglang/srt/speculative/dspark_components/dspark_verify.py",
+    "python/sglang/srt/utils/engine_failure.py",
+    "python/sglang/srt/utils/uvicorn_supervisor.py",
+    "python/sglang/srt/utils/watchdog.py",
+)
+
+
+def git(repo, *args, check=True):
+    return subprocess.run(
+        ["git", "-C", str(repo), *args], check=check, capture_output=True
+    )
+
+
+def sha(payload):
+    return hashlib.sha256(payload).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source-repo", type=Path, required=True)
+    parser.add_argument("--patches-commit", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    repo = args.source_repo
+    if git(repo, "status", "--porcelain").stdout:
+        raise SystemExit("source worktree must be clean")
+    revision = git(repo, "rev-parse", "HEAD").stdout.decode().strip()
+    git(repo, "merge-base", "--is-ancestor", BASE_SOURCE, revision)
+    if len(args.patches_commit) != 40 or any(
+        char not in "0123456789abcdef" for char in args.patches_commit
+    ):
+        raise SystemExit("patches commit must be a complete SHA")
+    args.output.mkdir(parents=True, exist_ok=False)
+    entries = []
+    for path in RUNTIME_FILES:
+        blob = git(repo, "show", f"{revision}:{path}").stdout
+        original = git(repo, "show", f"{BASE_SOURCE}:{path}", check=False)
+        entry = {
+            "path": path,
+            "before_sha256": sha(original.stdout) if original.returncode == 0 else None,
+            "after_sha256": sha(blob),
+        }
+        target = args.output / "overlay" / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(blob)
+        entries.append(entry)
+    manifest = dict(
+        source_repository="https://github.com/Phala-Network/sglang",
+        source_commit=revision,
+        source_tag="v" + VERSION,
+        patches_repository="https://github.com/Phala-Network/sglang-serving-patches",
+        patches_commit=args.patches_commit,
+        base_image=BASE_IMAGE,
+        base_source_commit=BASE_SOURCE,
+        version=VERSION,
+        embedded_governor="not selected; external PIG unchanged",
+        runtime_files=entries,
+        builder="CPU201 / 10.80.10.201",
+    )
+    (args.output / "image-inputs.json").write_text(
+        json.dumps(manifest, indent=2) + "\n"
+    )
+    dockerfile = f'''# syntax=docker/dockerfile:1
+FROM {BASE_IMAGE}
+LABEL org.opencontainers.image.source="https://github.com/Phala-Network/sglang" \\
+      org.opencontainers.image.revision="{revision}" \\
+      org.opencontainers.image.version="{VERSION}" \\
+      org.phala.patches.commit="{args.patches_commit}" \\
+      org.phala.base.image="{BASE_IMAGE}"
+ENV SGLANG_BUILD_COMMIT={revision} \\
+    SGLANG_IMAGE_TAG={VERSION} \\
+    SGLANG_BUILD_URL=https://github.com/Phala-Network/sglang/releases/tag/v{VERSION}
+COPY overlay/ /tmp/phala-watchdog-overlay/
+RUN python3 - <<'PY'
+from pathlib import Path
+import hashlib, json, py_compile, shutil
+entries = json.loads({json.dumps(json.dumps(entries))})
+root = Path('/sgl-workspace/sglang')
+staging = Path('/tmp/phala-watchdog-overlay')
+for entry in entries:
+    target = root / entry['path']
+    if entry['before_sha256'] is None:
+        assert not target.exists(), entry['path']
+    else:
+        assert hashlib.sha256(target.read_bytes()).hexdigest() == entry['before_sha256'], entry['path']
+    blob = (staging / entry['path']).read_bytes()
+    assert hashlib.sha256(blob).hexdigest() == entry['after_sha256'], entry['path']
+    target.write_bytes(blob)
+    py_compile.compile(str(target), doraise=True)
+shutil.rmtree(staging)
+print('PASS_WATCHDOG_DSPARK_OVERLAY', len(entries))
+PY
+'''
+    (args.output / "Dockerfile").write_text(dockerfile)
+    print(json.dumps(manifest))
+
+
+if __name__ == "__main__":
+    main()
