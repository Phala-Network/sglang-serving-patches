+def test_real_cache_separates_adapter_ids_from_colliding_caller_namespace():
+    from test_mamba_checkpoint_pressure import TestMambaCheckpointPressure
+
+    cache, allocator, pool = TestMambaCheckpointPressure().fixture(size=16)
+    config = RequestStaticYarnConfig.from_hf_config(SimpleNamespace(rope_parameters={
+        "rope_type": "yarn", "factor": 4.0, "request_static_factors": [1, 2, 4],
+        "original_max_position_embeddings": 256, "mrope_section": [11, 11, 10],
+    }))
+    tokens = list(range(64))
+    adapter_id = "a" * 32
+
+    def request(caller_namespace, adapter, factor=1):
+        req = Req("namespace-fixture", "", array("q", tokens + [1000]),
+                  SamplingParams(max_new_tokens=1, custom_params={"yarn_factor": factor}),
+                  extra_key=caller_namespace,
+                  lora_id=adapter)
+        return req
+
+    adapted = request(None, adapter_id)
+    base = request(adapter_id, None)
+    assert adapted.extra_key == base.extra_key == adapter_id
+    admit_request_static_yarn(adapted, config, 1024)
+    admit_request_static_yarn(base, config, 1024)
+    assert adapted.extra_key != base.extra_key
+    indices = allocator.alloc(64)
+    slot = pool.mamba_allocator.alloc(1)
+    assert indices is not None and slot is not None
+    cache.insert(InsertParams(key=cache_key(adapted, tokens), value=indices,
+                              mamba_value=slot))
+    miss = cache.match_prefix(MatchPrefixParams(key=cache_key(base, tokens + [1000])))
+    assert len(matched_indices(cache, miss)) == 0
+    repeated = request(None, adapter_id)
+    admit_request_static_yarn(repeated, config, 1024)
+    hit = cache.match_prefix(MatchPrefixParams(key=cache_key(repeated, tokens + [1000])))
+    assert torch.equal(matched_indices(cache, hit), indices)
+    for isolated in (request("caller", adapter_id), request(None, adapter_id, 2),
+                     request(None, "b" * 32), request(None, None)):
+        admit_request_static_yarn(isolated, config, 1024)
+        cold = cache.match_prefix(MatchPrefixParams(key=cache_key(isolated, tokens + [1000])))
+        assert len(matched_indices(cache, cold)) == 0
+    default_base = request(None, None)
+    admit_request_static_yarn(default_base, config, 1024)
+    base_indices = allocator.alloc(64)
+    base_slot = pool.mamba_allocator.alloc(1)
+    assert base_indices is not None and base_slot is not None
+    cache.insert(InsertParams(key=cache_key(default_base, tokens), value=base_indices,
+                              mamba_value=base_slot))
+    base_repeat = request(None, None)
+    admit_request_static_yarn(base_repeat, config, 1024)
+    base_hit = cache.match_prefix(MatchPrefixParams(key=cache_key(base_repeat, tokens + [1000])))
+    assert torch.equal(matched_indices(cache, base_hit), base_indices)
+    cache.evict(EvictParams(num_tokens=4096, mamba_num=16))
+    assert allocator.available_size() == 4096
+    assert pool.mamba_allocator.available_size() == 16
