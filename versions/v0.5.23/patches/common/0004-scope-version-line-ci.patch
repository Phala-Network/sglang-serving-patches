-              ? runLink(ptRun)
-              : (!hasCI ? missingCIText : '_Not run yet_');
-            const peText = isReal(peRun)
-              ? runLink(peRun)
-              : !hasCI
-                ? peBlockedByCIText
-                : !hasExtra
-                  ? notExtraEnabledText
