+    def test_utf8_roundtrip(self):
+        text = '你好 🌏 café Ελληνικά\nTools: {"city":"杭州"}\tend'
+        for tokenizer in self.tokenizers.values():
+            ids = tokenizer.encode(text, add_special_tokens=False)
