diff --git a/python/sglang/srt/arg_groups/model_hook.py b/python/sglang/srt/arg_groups/model_hook.py
index b71a4cc53584ad962c22f2b49a6f7aaa4a068191..10a936ee1f9d655791028dad374a4ae6977a74b6 100644
