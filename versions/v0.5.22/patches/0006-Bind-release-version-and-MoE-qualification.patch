From 386bc8376cac5121fe93ccdb75954631a7a4e64c Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 22 Oct 2026 04:35:08 +0000
Subject: [PATCH] Bind release image version and qualify the retained MoE
 stream

---
 docker/xing4-0522/Dockerfile | 3 ++-
 docker/xing4-0522/qualify.py | 1 +
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/docker/xing4-0522/Dockerfile b/docker/xing4-0522/Dockerfile
index d27f84496b8b31799bf30779d60ee93fe8bd84e7..76b5a384a5fcaa3eee26bd2aa810b4970472f60f 100644
--- a/docker/xing4-0522/Dockerfile
+++ b/docker/xing4-0522/Dockerfile
@@ -1,8 +1,9 @@
 FROM docker.io/lmsysorg/sglang@sha256:5fc09edb6a0bb1d5b6992b543723c66d08f86d7a507e951e87e0d05db4ac766e
 ARG ENGINE_REVISION
+ARG IMAGE_VERSION
 LABEL org.opencontainers.image.source="https://github.com/Phala-Network/sglang" \
       org.opencontainers.image.revision="${ENGINE_REVISION}" \
-      org.opencontainers.image.version="0.5.22-xing4-candidate-20261021"
+      org.opencontainers.image.version="${IMAGE_VERSION}"
 COPY python/ /sgl-workspace/sglang/python/
 COPY test/registered/unit/ /sgl-workspace/sglang/test/registered/unit/
 COPY docker/xing4-0522/ /opt/phala/xing4-0522/
diff --git a/docker/xing4-0522/qualify.py b/docker/xing4-0522/qualify.py
index 12f37f2892827f68b9fa584f4dd980b63eed8024..86a19d8db5639959615946854787a74a84b5a033 100644
--- a/docker/xing4-0522/qualify.py
+++ b/docker/xing4-0522/qualify.py
@@ -13,6 +13,7 @@ ROOT = Path("/sgl-workspace/sglang")
 MANIFEST = Path("/opt/phala/candidate-source.json")
 TESTS = [
     "models/test_xing4_native.py",
+    "models/test_xing4_moe_alt_stream.py",
     "models/test_xing4_runtime_auth.py",
     "models/test_xing4_tokenizer.py",
     "managers/test_xing_native_eagle_public_budget.py",
