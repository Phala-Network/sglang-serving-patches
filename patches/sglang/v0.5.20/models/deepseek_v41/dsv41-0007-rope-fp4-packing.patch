+        .head_weights = weights ? static_cast<const bf16_t*>(head_weights->data_ptr()) : nullptr,
+        .weights_out = weights ? static_cast<float*>(weights_out->data_ptr()) : nullptr,
+        .weight_scale = weight_scale,
