+                tp_cache_group=None,
+                attn_cp_cache_group=None,
+                attn_tp_cache_group=None,
+                pp_cache_group=None,
+            )
+            with (
+                patch(prefix + "build_kv_host_pool") as anchor,
+                patch(prefix + "HybridCacheController"),
+            ):
