+        check_ratio_mode()
+        for layout, backend in (
+            ("page_first", "kernel"),
+            ("layer_first", "kernel"),
+            ("layer_first", "direct"),
+            ("page_first_direct", "direct"),
+        ):
+            for trial in range(5):
+                for standalone in (False, True):
+                    run_case(layout, backend, trial, standalone=standalone)
+    print("Hybrid DSA HiCache GPU byte oracle: 40/40 passed", flush=True)
