+            locs = compute_pooled_write_locs(dst_pages, torch.arange(128), 4)
+            self.assertTrue(torch.equal(locs[:64], 2 * 64 + torch.arange(64)))
+            self.assertTrue(torch.equal(locs[64:], 7 * 64 + torch.arange(64)))
