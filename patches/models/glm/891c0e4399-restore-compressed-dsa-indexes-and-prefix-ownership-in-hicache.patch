+                "backend": backend,
+                "trial": trial,
+                "standalone": standalone,
+                "layers": 3,
+                "pages": 8,
+                "bytes_compared": 3 * 8 * 8448,
+                "passed": True,
+            }
+        ),
+        flush=True,
+    )
