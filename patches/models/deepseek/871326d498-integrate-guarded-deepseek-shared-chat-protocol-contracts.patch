+    def test_inline_size_and_malformed_base64(self):
+        obj = serving(multimodal=True, image=True, audio=True)
+        exact = "YWFh" * (1024 * 1024 // 3) + "YQ=="
+        self.assertIsNone(
+            obj._validate_request(
