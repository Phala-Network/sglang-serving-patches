+
+
+import importlib.machinery
+
+
+import sys
+
+
+_TARGET = "sglang.srt.entrypoints.openai.encoding_dsv41"
+
+
+REASONING_EFFORT_MAPPINGS = {
+    "minimal": 25,
+    "low": 50,
+    "medium": 62,
+    "high": 75,
