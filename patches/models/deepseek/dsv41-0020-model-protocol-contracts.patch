+                finish_reason="stop")],
+            usage=P.UsageInfo(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+        )
+
+    def _process_reasoning_stream(self, index, delta, parsers, content, request, *a, **kw):
+        return "secret", "answer"
