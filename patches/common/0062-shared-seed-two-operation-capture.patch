+                doc["page_range"].update(end=10**18),
+                doc["operation_ranges"][1].update(end=10**18),
+            ),
+        ):
+            document = copy.deepcopy(original)
+            mutate(document)
+            document.pop("manifest_sha256")
+            document["manifest_sha256"] = hashlib.sha256(
+                json.dumps(
