+        original = self.manifest()
+        for mutate in (
+            lambda doc: doc.update(backup_ack={"complete": True}),
+            lambda doc: doc["operations"][1].update(complete=False),
+            lambda doc: doc["operations"][1].update(
+                operation_id=doc["operations"][0]["operation_id"]
