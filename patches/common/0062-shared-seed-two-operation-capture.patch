+            not isinstance(key_id, str)
+            or key_id not in key_ids
+            or key_id in put_ids
+            or type(put.get("native_result")) is not int
+            or put["native_result"] != 0
+            or put.get("already_present") is not False
+        ):
+            return False
+        put_ids.add(key_id)
+    return put_ids == key_ids
