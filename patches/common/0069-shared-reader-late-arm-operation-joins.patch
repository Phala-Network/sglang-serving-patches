+    def operation(self, rid="reader-a", room=71, ident=7, page="first", attempt=0):
+        operation = NS(
+            handle=Handle(
+                rid, attempt, room, hashlib.sha256(f"{rid}:{room}".encode()).hexdigest()
+            ),
+            request_id=rid,
+            id=ident,
