+                for line in files[0].read_text(encoding="utf-8").splitlines()
+                if line.strip()
+            ]
+            self.assertEqual(len(stdout_lines), 2)
+            self.assertEqual(len(file_lines), 2)
+            for line in stdout_lines + file_lines:
