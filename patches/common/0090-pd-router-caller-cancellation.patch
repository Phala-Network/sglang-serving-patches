diff --git a/sgl-model-gateway/tests/reliability/upstream_cancel_test.rs b/sgl-model-gateway/tests/reliability/upstream_cancel_test.rs
index 2b915516e09c3c7120dea5f90baf8a042a32e84d..4709de2d3576a639ff48ec27d565680c00fec211 100644
--- a/sgl-model-gateway/tests/reliability/upstream_cancel_test.rs
+++ b/sgl-model-gateway/tests/reliability/upstream_cancel_test.rs
@@ -113,6 +113,489 @@ async fn assert_cancelled_before_completion(port: u16) -> StreamTrackingState {
 mod upstream_cancel_tests {
     use super::*;
 
+    // Real build_app -> PDRouter -> reqwest calls. The gates deliberately have
+    // no response timers; EOF/reset is positive evidence of upstream cancel.
+    const PD_BOUND: Duration = Duration::from_secs(3);
+
+    struct PdCallerCleanup(tokio::task::AbortHandle);
+    impl Drop for PdCallerCleanup {
+        fn drop(&mut self) {
+            self.0.abort();
+        }
+    }
+
+    enum PdWireAction {
+        Response(&'static str, &'static str),
+        TransportFailure,
+        DelayedErrorBody(tokio::sync::oneshot::Receiver<()>),
+    }
+
+    struct PdWire {
+        started: tokio::sync::oneshot::Receiver<()>,
+        release: Option<tokio::sync::oneshot::Sender<PdWireAction>>,
+        finished: tokio::sync::oneshot::Receiver<bool>,
+        task: tokio::task::JoinHandle<()>,
+    }
+
+    impl Drop for PdWire {
+        fn drop(&mut self) {
+            // Cleanup only. Every cancellation assertion awaits socket EOF
+            // before this guard is dropped; abort is never test evidence.
+            self.task.abort();
+        }
+    }
+
+    impl PdWire {
+        async fn bind(port: u16) -> Self {
+            use tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let listener = tokio::net::TcpListener::bind(("127.0.0.1", port))
+                .await
+                .unwrap();
+            let (started_tx, started) = tokio::sync::oneshot::channel();
+            let (release, release_rx) = tokio::sync::oneshot::channel();
+            let (finished_tx, finished) = tokio::sync::oneshot::channel();
+            let task = tokio::spawn(async move {
+                let (mut socket, _) = listener.accept().await.unwrap();
+                let mut request = Vec::new();
+                loop {
+                    let mut byte = [0; 1];
+                    assert_eq!(socket.read(&mut byte).await.unwrap(), 1);
+                    request.push(byte[0]);
+                    assert!(request.len() < 65536);
+                    if request.ends_with(b"\r\n\r\n") {
+                        break;
+                    }
+                }
+                let headers = std::str::from_utf8(&request).unwrap();
+                assert!(headers.starts_with("POST /generate HTTP/1.1\r\n"));
+                let length: usize = headers
+                    .lines()
+                    .filter_map(|s| s.split_once(':'))
+                    .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+                    .unwrap()
+                    .1
+                    .trim()
+                    .parse()
+                    .unwrap();
+                assert!(length < 65536);
+                let mut body = vec![0; length];
+                socket.read_exact(&mut body).await.unwrap();
+                let payload: serde_json::Value = serde_json::from_slice(&body).unwrap();
+                assert_eq!(payload["text"], "early-decode-regression");
+                started_tx.send(()).unwrap();
+                let mut byte = [0; 1];
+                let closed = tokio::select! {
+                    read = socket.read(&mut byte) => match read {
+                        Ok(0) => true,
+                        Err(e) if matches!(e.kind(), std::io::ErrorKind::ConnectionReset
+                            | std::io::ErrorKind::ConnectionAborted) => true,
+                        other => panic!("expected gateway EOF/reset, got {other:?}"),
+                    },
+                    action = release_rx => {
+                        match action.expect("retain release gate until assertion") {
+                            PdWireAction::Response(status, body) => {
+                                let reply = format!("HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len());
+                                socket.write_all(reply.as_bytes()).await.unwrap();
+                            }
+                            PdWireAction::TransportFailure => {}
+                            PdWireAction::DelayedErrorBody(gate) => {
+                                let body = r#"{"error":{"message":"early decode rejection"}}"#;
+                                let headers = format!("HTTP/1.1 503 Service Unavailable\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len());
+                                socket.write_all(headers.as_bytes()).await.unwrap();
+                                gate.await.expect("release error body only after P disconnect");
+                                socket.write_all(body.as_bytes()).await.unwrap();
+                            }
+                        }
+                        socket.shutdown().await.unwrap();
+                        false
+                    }
+                };
+                finished_tx.send(closed).unwrap();
+            });
+            Self {
+                started,
+                release: Some(release),
+                finished,
+                task,
+            }
+        }
+
+        async fn started(&mut self) {
+            tokio::time::timeout(PD_BOUND, &mut self.started)
+                .await
+                .expect("both real POSTs must arrive")
+                .unwrap();
+        }
+
+        fn release(&mut self, action: PdWireAction) {
+            assert!(self.release.take().unwrap().send(action).is_ok());
+        }
+
+        async fn finished(&mut self, peer_closed: bool) {
+            let actual = tokio::time::timeout(PD_BOUND, &mut self.finished)
+                .await
+                .expect("upstream must observe completion or EOF/reset")
+                .unwrap();
+            assert_eq!(actual, peer_closed, "true is observed gateway EOF/reset");
+        }
+    }
+
+    async fn pd_wire_context(port: u16) -> (AppTestContext, PdWire, PdWire) {
+        use smg::config::RetryConfig;
+        let config = RouterConfig::builder()
+            .prefill_decode_mode(
+                vec![(format!("http://127.0.0.1:{port}"), None)],
+                vec![format!("http://127.0.0.1:{}", port + 1)],
+            )
+            .round_robin_policy()
+            .host("127.0.0.1")
+            .port(4390)
+            .request_timeout_secs(60)
+            .worker_startup_timeout_secs(5)
+            .worker_startup_check_interval_secs(1)
+            .max_concurrent_requests(32)
+            .retry_config(RetryConfig {
+                max_retries: 1,
+                initial_backoff_ms: 1,
+                max_backoff_ms: 1,
+                backoff_multiplier: 1.0,
+                jitter_factor: 0.0,
+            })
+            .build_unchecked();
+        // Reuse normal mock discovery/registration and pinned breaker handles.
+        // Replace listeners only after initialization. AppTestContext does not
+        // spawn server.rs's periodic health checker.
+        let mut ctx = AppTestContext::new_with_config(
+            config,
+            vec![
+                TestWorkerConfig::prefill(port),
+                TestWorkerConfig::decode(port + 1),
+            ],
+        )
+        .await;
+        ctx.workers[0].stop().await;
+        ctx.workers[1].stop().await;
+        let p = PdWire::bind(port).await;
+        let d = PdWire::bind(port + 1).await;
+        (ctx, p, d)
+    }
+
+    fn pd_wire_request(stream: bool) -> Request {
+        Request::builder()
+            .method("POST")
+            .uri("/generate")
+            .header(CONTENT_TYPE, "application/json")
+            .body(Body::from(
+                json!({"text": "early-decode-regression", "stream": stream}).to_string(),
+            ))
+            .unwrap()
+    }
+
+    async fn pd_early_failure(port: u16, stream: bool, transport: bool) {
+        let (ctx, mut p, mut d) = pd_wire_context(port).await;
+        let prefill = pin_worker(&ctx, &format!("http://127.0.0.1:{port}"));
+        let decode = pin_worker(&ctx, &format!("http://127.0.0.1:{}", port + 1));
+        let before_p = breaker_counts(&prefill);
+        let before_d = breaker_counts(&decode);
+        let app = ctx.create_app().await;
+        let mut caller = tokio::spawn(app.oneshot(pd_wire_request(stream)));
+        let _caller_cleanup = PdCallerCleanup(caller.abort_handle());
+        p.started().await;
+        d.started().await;
+        let (body_tx, body_rx) = tokio::sync::oneshot::channel();
+        d.release(if transport {
+            PdWireAction::TransportFailure
+        } else {
+            PdWireAction::DelayedErrorBody(body_rx)
+        });
+        // P never produces headers. D's error BODY also remains withheld:
+        // P must close on D's status, before error shaping reads that body.
+        p.finished(true).await;
+        assert!(p.release.is_some());
+        if !transport {
+            body_tx.send(()).unwrap();
+        }
+        d.finished(false).await;
+        let response = tokio::time::timeout(PD_BOUND, &mut caller)
+            .await
+            .expect("early D failure must return without P")
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            response.status(),
+            if transport {
+                StatusCode::BAD_GATEWAY
+            } else {
+                StatusCode::SERVICE_UNAVAILABLE
+            }
+        );
+        let body = tokio::time::timeout(PD_BOUND, response.into_body().collect())
+            .await
+            .unwrap()
+            .unwrap()
+            .to_bytes();
+        let text = String::from_utf8_lossy(&body);
+        assert!(
+            text.contains(if transport {
+                "Decode server error"
+            } else {
+                "early decode rejection"
+            }),
+            "{text}"
+        );
+        assert_eq!(
+            breaker_counts(&prefill),
+            before_p,
+            "cancelled P has no outcome"
+        );
+        assert_eq!(
+            breaker_counts(&decode),
+            (before_d.0, before_d.1 + 1),
+            "D fails exactly once"
+        );
+        ctx.shutdown().await;
+    }
+
