+            namespace,
+        )
+        controller.page_size = 4
+
+        def exists(batch, extra_info):
+            calls.append((list(batch), extra_info))
+            return 2 if len(calls) == 1 else 1
+
+        controller.storage_backend = NS(batch_exists=exists)
+        operation = NS(
+            last_hash="prefix",
+            token_ids=list(range(20)),
