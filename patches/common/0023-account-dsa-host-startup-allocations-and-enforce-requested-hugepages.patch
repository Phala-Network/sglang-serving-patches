+def install(name, module=None):
+    parts = name.split(".")
+    for i in range(1, len(parts)):
+        package_name = ".".join(parts[:i])
+        if package_name not in sys.modules:
+            package = types.ModuleType(package_name)
+            package.__path__ = []
+            sys.modules[package_name] = package
+    module = module or types.ModuleType(name)
+    sys.modules[name] = module
+    return module
+
+
+def execute(path, name, namespace, names=None):
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    body = [ast.ImportFrom(module="__future__", names=[ast.alias("annotations")], level=0)]
+    for item in tree.body:
+        if isinstance(item, (ast.Import, ast.ImportFrom)):
+            continue
+        if names is None or getattr(item, "name", None) in names:
+            body.append(item)
+    module = install(name)
+    module.__dict__.update(namespace)
+    exec(compile(ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])), str(path), "exec"), module.__dict__)
+    return module
+
