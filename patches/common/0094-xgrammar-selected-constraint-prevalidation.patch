+            )
+            schema = {
+                "type": "object",
+                "propertyNames": True,
+                "additionalProperties": True,
+            }
+            grammar = backend.dispatch_structural_tag(json.dumps(tag(schema)))
+            self.assertNotIsInstance(grammar, InvalidGrammarObject)
+            self.assertTrue(
+                grammar.matcher.accept_string('<call>{"x":1}</call>')
