+        self.assertEqual(forward["event"], "prefill_forward_complete")
+        self.assertEqual(forward["h_tokens"], 128)
+        self.assertEqual(forward["n_tokens"], 385)
+        self.assertEqual(forward["suffix_tokens"], 257)
