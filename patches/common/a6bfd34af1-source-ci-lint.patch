diff --git a/.github/workflows/phala-source-check.yml b/.github/workflows/phala-source-check.yml
new file mode 100644
index 0000000000000000000000000000000000000000..2aca1e7b2633208f507d8c3ee9452404968d5b03
--- /dev/null
+++ b/.github/workflows/phala-source-check.yml
@@ -0,0 +1,54 @@
+name: Phala source checks
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: phala-source-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  source:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
