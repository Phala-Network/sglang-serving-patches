+      - uses: actions/cache@v4
+        with:
+          path: ~/.cache/pre-commit
+          key: phala-source-${{ runner.os }}-${{ hashFiles('.pre-commit-config.yaml') }}
+      - name: Python, configuration and source-registry lint
+        run: |
+          set -euo pipefail
+          for hook in check-symlinks destroyed-symlinks trailing-whitespace \
+            end-of-file-fixer check-yaml check-toml check-ast check-added-large-files \
+            check-merge-conflict detect-private-key debug-statements \
+            isort ruff ruff-format check-registered-tests; do
+            pre-commit run "$hook" --all-files --show-diff-on-failure
+          done
+      - name: CPU source-method regressions
+        run: |
+          set -euo pipefail
+          python test/manual/phala/test_muse_migration_cpu.py
+          python test/manual/phala/test_nemotron_token_context_cpu.py
+          python test/manual/phala/test_dsv41_chat_migration_cpu.py
+          python test/manual/unit/function_call/test_qwen_complete_call_cpu.py
+          python test/manual/unit/entrypoints/openai/test_qwen_historical_source_semantics.py
+          python test/manual/unit/model_executor/model_runner_components/test_marlin_breakable_source_contract.py
+          python test/manual/test_hicache_async_ack_sync.py
+      # Native Rust/kernel checks and the complete upstream lint remain manual
+      # in lint.yml. Real-tokenizer/template and torch GGUF tests additionally
+      # run in the pinned local CPU environment; this is not GPU acceptance.
