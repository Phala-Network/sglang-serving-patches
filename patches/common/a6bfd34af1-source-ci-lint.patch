+                self.assertEqual(chooser.called, not fp32)
+
+    def test_only_breakable_bypasses_gqa_gate_and_capture_uses_gate(self):
+        ns = {}
+        load_functions(SRT / "model_executor/cuda_graph_config.py", ["Backend"], ns)
