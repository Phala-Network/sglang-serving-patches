+int32_t JSONSchemaConverter::GetExactOrderKeyPatternExcluding(
+    const std::vector<ObjectSpec::Property>& properties, const std::string& rule_name
+) {
+  struct KeyNode {
+    bool terminal = false;
+    std::map<TCodepoint, KeyNode> children;
+  } root;
+  for (const auto& property : properties) {
+    auto* node = &root;
+    for (auto cp : ParseUTF8(property.name.c_str())) {
+      XGRAMMAR_CHECK(cp >= 0) << "Invalid UTF-8 in declared property name";
+      node = &node->children[cp];
+    }
+    node->terminal = true;
+  }
+  const std::map<TCodepoint, std::string> short_escapes = {
+      {'"', "\\\""}, {'\\', "\\\\"}, {'/', "\\/"}, {'\b', "\\b"},
+      {'\f', "\\f"}, {'\n', "\\n"}, {'\r', "\\r"}, {'\t', "\\t"}
+  };
+  std::function<int32_t(const KeyNode&)> build = [&](const KeyNode& node) -> int32_t {
+    std::vector<int32_t> choices;
+    if (!node.terminal) choices.push_back(ByteString("\""));
+    std::vector<std::pair<TCodepoint, TCodepoint>> excluded = {
+        {0, 0x1f}, {'"', '"'}, {'\\', '\\'}, {0xd800, 0xdfff}
+    };
+    for (const auto& [cp, child] : node.children) {
+      static_cast<void>(child);
+      excluded.push_back({cp, cp});
+    }
+    // After the first different decoded character no suffix can alias a
+    // declared key, so the full JSON string suffix is safe.
+    // Use positive Unicode ranges. The upstream negative character-class
+    // normalizer is ASCII-only and would silently admit excluded non-ASCII keys.
+    std::sort(excluded.begin(), excluded.end());
+    std::vector<CharacterClassElement> allowed;
+    TCodepoint lower = 0;
+    for (const auto& [begin, end] : excluded) {
+      if (lower < begin) allowed.push_back({lower, begin - 1});
+      lower = std::max(lower, end + 1);
+    }
+    if (lower <= 0x10ffff) allowed.push_back({lower, 0x10ffff});
+    choices.push_back(Sequence({builder_.AddCharacterClass(allowed), RuleRef(kBasicStringSub)}));
+    for (const auto& [cp, spelling] : short_escapes) {
+      if (!node.children.count(cp)) {
+        choices.push_back(Sequence({ByteString(spelling), RuleRef(kBasicStringSub)}));
+      }
+    }
+    for (const auto& [cp, child] : node.children) {
+      std::string encoded = picojson::value(CharToUTF8(cp)).serialize();
+      encoded = encoded.substr(1, encoded.size() - 2);
+      std::vector<int32_t> spellings = {ByteString(encoded)};
+      if (cp == '/') spellings.push_back(ByteString("\\/"));
+      choices.push_back(Sequence({Choice(spellings), build(child)}));
+    }
+    // While a name can still match a declared key, require its canonical UTF-8
+    // / short-escape spelling. Arbitrary \\u aliases at that prefix are not
+    // permitted: the upstream generic-escape branch could otherwise bypass
+    // required/type/duplicate-key constraints. Values are unaffected.
+    return Choice(choices);
+  };
+  int32_t id = builder_.AddRuleWithHint(
+      rule_name + "_exact_addl_key", Sequence({ByteString("\""), build(root)})
+  );
+  return RuleRef(id);
+}
