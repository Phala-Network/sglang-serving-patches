+int32_t JSONSchemaConverter::GetExactOrderRuleForProperties(
+    const std::vector<ObjectSpec::Property>& properties,
+    const std::unordered_set<std::string>& required,
+    const SchemaSpecPtr& additional,
+    const std::string& rule_name,
+    const std::string& additional_suffix
+) {
+  const size_t state_count = size_t{1} << properties.size();
+  XGRAMMAR_CHECK(state_count <= exact_order_states_left_);
+  exact_order_states_left_ -= state_count;
+  int32_t first_separator = NextSeparatorExpression();
+  int32_t middle_separator = NextSeparatorExpression();
+  int32_t last_separator = NextSeparatorExpression(true);
+
+  size_t required_mask = 0;
+  std::vector<int32_t> patterns;
+  for (size_t index = 0; index < properties.size(); ++index) {
+    const auto& property = properties[index];
+    if (required.count(property.name)) required_mask |= size_t{1} << index;
+    int32_t value_rule_id =
+        CreateRule(property.schema, rule_name + "_prop_" + std::to_string(index));
+    patterns.push_back(
+        FormatProperty(property.name, value_rule_id, rule_name, index, property.schema)
+    );
+  }
+  std::optional<int32_t> extra;
+  if (additional != nullptr) {
+    int32_t value_rule_id = CreateRule(additional, rule_name + "_" + additional_suffix);
+    extra = FormatOtherProperty(
+        GetExactOrderKeyPatternExcluding(properties, rule_name), value_rule_id,
+        rule_name, additional_suffix, /*schema=*/nullptr
+    );
+  }
+
+  // Each state records exactly which declared keys were consumed. Additional
+  // keys never stand in for a required key and cannot alias a declared key.
+  std::vector<int32_t> tails;
+  for (size_t mask = 0; mask < state_count; ++mask) {
+    tails.push_back(builder_.AddRuleWithHint(
+        rule_name + "_exact_order_" + std::to_string(mask), Empty()
+    ));
+  }
+  for (size_t mask = 0; mask < state_count; ++mask) {
+    std::vector<int32_t> choices;
+    if ((mask & required_mask) == required_mask) choices.push_back(Empty());
+    for (size_t index = 0; index < properties.size(); ++index) {
+      const size_t bit = size_t{1} << index;
+      if (!(mask & bit)) {
+        choices.push_back(Sequence({
+            middle_separator, patterns[index], RuleRef(tails[mask | bit])
+        }));
+      }
+    }
+    if (extra.has_value()) {
+      // This recursion always consumes a comma, key and value; it cannot be
+      // an epsilon/whitespace-only loop.
+      choices.push_back(Sequence({middle_separator, *extra, RuleRef(tails[mask])}));
+    }
+    builder_.UpdateRuleBody(tails[mask], Choice(choices));
+  }
+
+  std::vector<int32_t> first;
+  for (size_t index = 0; index < properties.size(); ++index) {
+    first.push_back(Sequence({patterns[index], RuleRef(tails[size_t{1} << index])}));
+  }
+  if (extra.has_value()) first.push_back(Sequence({*extra, RuleRef(tails[0])}));
+  return Sequence({first_separator, Choice(first), last_separator});
+}
