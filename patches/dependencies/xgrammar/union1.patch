+"""CPU-native regressions for the shared Phala JSON/XML dependency.
+
+Sources: historical Qwen r5 and Muse/Nemotron strictorder4 fixtures. Raw-byte
+vocabulary tests exercise real compiled masks/rollback without model downloads.
+"""
+
+import itertools
+import json
+
+import pytest
+import torch
+
+import xgrammar as xg
+from xgrammar.testing import _is_grammar_accept_string, _json_schema_to_ebnf
+
+
+def accepts(schema, text, **kwargs):
+    return _is_grammar_accept_string(
+        xg.Grammar.from_json_schema(schema, max_whitespace_cnt=64, **kwargs), text
+    )
+
+
+@pytest.fixture(scope="module")
+def compiler():
+    vocab = [bytes([i]) for i in range(256)] + [b"aa", b'a"', b'aa"', b"<eos>"]
+    info = xg.TokenizerInfo(vocab, xg.VocabType.RAW, stop_token_ids=[259])
+    return xg.GrammarCompiler(info, max_threads=2)
+
+
+@pytest.mark.parametrize("required", [[], ["foo"], ["foo", "barbaz"]])
+@pytest.mark.parametrize("additional", [True, False, {"type": "integer"}])
+def test_exact_order_all_permutations(required, additional):
+    schema = {
+        "type": "object",
+        "properties": {"foo": {"type": "boolean"}, "barbaz": {"type": "string"}},
+        "required": required,
+        "additionalProperties": additional,
+    }
+    items = [("foo", True), ("barbaz", "x")]
+    if additional is not False:
+        items += [("zzz", 1), ("first", 2)]
+    grammar = xg.Grammar.from_json_schema(schema, max_whitespace_cnt=64)
+    for length in range(len(items) + 1):
+        for subset in itertools.combinations(items, length):
+            expected = set(required).issubset(dict(subset))
+            for ordered in itertools.permutations(subset):
+                text = json.dumps(dict(ordered), ensure_ascii=False)
+                assert _is_grammar_accept_string(grammar, text) == expected, text
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        '{"barbaz":"x"}',
+        '{"barbaz":"x","foo":"wrong"}',
+        '{"foo":true,"barbaz":"x","foo":false}',
+        '{"barbaz":"x","barbaz":"y","foo":true}',
+        '{"foo":true,"barbaz":"x","\\u0066oo":"wrong"}',
+        '{"foo":true,"barbaz":"x","f\\u006fo":"wrong"}',
+        '{"foo":true,"barbaz":"x",}',
+        '{"foo":true,"barbaz":"x"} prose',
+        '{"barbaz":"x",' + " " * 65 + '"foo":true}',
+    ],
+)
+def test_exact_order_rejects_missing_wrong_duplicate_and_escaped_aliases(text):
+    schema = {
+        "type": "object",
+        "properties": {"foo": {"type": "boolean"}, "barbaz": {"type": "string"}},
+        "required": ["foo", "barbaz"],
+        "additionalProperties": True,
+    }
+    assert not accepts(schema, text)
+
+
+def test_unicode_keys_and_nested_references():
+    item = {
+        "type": "object",
+        "properties": {"中文": {"type": "integer"}, 'a"b': {"type": "boolean"}},
+        "required": ["中文", 'a"b'],
+        "additionalProperties": True,
+    }
+    assert accepts(item, json.dumps({'a"b': True, "extra\nkey": 3, "中文": 1},
+                                   ensure_ascii=False))
+    assert not accepts(item, '{"中文":1,"a\\"b":true,"\\u4e2d文":"wrong"}')
+    schema = {"$defs": {"item": item}, "type": "object",
+              "properties": {"item": {"$ref": "#/$defs/item"}, "n": {"const": 7}},
+              "required": ["item", "n"], "additionalProperties": False}
+    assert accepts(schema, '{"n":7,"item":{"a\\"b":true,"中文":1}}')
+    assert not accepts(schema, '{"n":7,"item":{"a\\"b":true}}')
+
+
+@pytest.mark.parametrize("properties", [8, 9])
+def test_exact_order_size_bound_preserves_required(properties):
+    schema = {"type": "object",
+              "properties": {f"k{i}": {"type": "integer"} for i in range(properties)},
+              "required": [f"k{i}" for i in range(properties)], "additionalProperties": False}
+    assert accepts(schema, json.dumps({f"k{i}": i for i in range(properties)}))
+    assert not accepts(schema, json.dumps({f"k{i}": i for i in range(properties - 1)}))
+    if properties == 8:
+        assert accepts(schema, json.dumps({f"k{i}": i for i in reversed(range(properties))}))
+
+
+@pytest.mark.parametrize("minimum", [1, 127, 128, 129, 200, 1000, 16385])
+@pytest.mark.parametrize("delta", [-1, 0, 1])
+@pytest.mark.parametrize("ascii_only", [False, True])
+def test_decoded_unicode_length_at_block_edges(compiler, minimum, delta, ascii_only):
+    ctx = compiler.compile_json_schema({"type": "string", "minLength": minimum})
+    count = minimum + delta
+    value = "a" * max(count - 1, 0) + ("😀" if count else "")
+    assert xg.GrammarMatcher(ctx).accept_string(json.dumps(value, ensure_ascii=ascii_only)) == (
+        delta >= 0
+    )
+
+
+@pytest.mark.parametrize("escape", [r"\n", r"\"", r"\\", r"\u0041", r"\uD83D\uDE00"])
+def test_escape_is_one_character_at_128_boundary(compiler, escape):
+    ctx = compiler.compile_json_schema({"type": "string", "minLength": 129})
+    matcher = xg.GrammarMatcher(ctx)
+    assert matcher.accept_string('"' + "a" * 127 + escape)
+    assert not matcher.accept_string('"')
+    assert matcher.accept_string('a"')
+
+
+@pytest.mark.parametrize("invalid", [r"\uD800", r"\uDC00", r"\uD83D\u0041", "\t", "\x00"])
+@pytest.mark.parametrize("bounded", [False, True])
+def test_invalid_escape_or_control(compiler, invalid, bounded):
+    schema = {"type": "string", "minLength": 129}
+    if bounded:
+        schema["maxLength"] = 140
+    ctx = compiler.compile_json_schema(schema)
+    assert not xg.GrammarMatcher(ctx).accept_string('"' + "a" * 128 + invalid + '"')
+
+
+def test_multichar_token_mask_rollback_and_eos(compiler):
+    ctx = compiler.compile_json_schema({"type": "string", "minLength": 129})
+    matcher = xg.GrammarMatcher(ctx, max_rollback_tokens=5)
+    assert matcher.accept_string('"' + "a" * 127)
+    mask = xg.allocate_token_bitmask(1, 260)
+    matcher.fill_next_token_bitmask(mask)
+    before = mask.clone()
+
+    def allowed(index):
+        return bool(int(mask[0, index // 32]) & (1 << (index % 32)))
+
+    assert allowed(256)
+    assert not allowed(257)
+    assert allowed(258)
+    assert matcher.accept_token(256)
+    matcher.fill_next_token_bitmask(mask)
+    reached = mask.clone()
+    assert allowed(ord('"'))
+    matcher.rollback(1)
+    matcher.fill_next_token_bitmask(mask)
+    assert torch.equal(mask, before)
+    assert matcher.accept_token(256)
+    matcher.fill_next_token_bitmask(mask)
+    assert torch.equal(mask, reached)
+    assert matcher.accept_token(ord('"'))
+    assert matcher.accept_token(259)
+    assert matcher.is_terminated()
+    matcher.rollback(2)
+    matcher.fill_next_token_bitmask(mask)
+    assert torch.equal(mask, reached)
+
+
+@pytest.mark.parametrize("minimum", [128, 129, 200, 1000])
+@pytest.mark.parametrize("delta", [-1, 0, 1, 129])
+def test_unbounded_repetition_prefix(compiler, minimum, delta):
+    grammar = f'root ::= "[" ("ab" | "cd"){{{minimum},}} "]"'
+    matcher = xg.GrammarMatcher(compiler.compile_grammar(grammar))
+    assert matcher.accept_string("[" + "ab" * (minimum + delta))
+    assert matcher.accept_string("]") == (delta >= 0)
+
+
+@pytest.mark.parametrize("length", [0, 1, 128, 129, 200, 258])
+def test_nullable_and_overlapping_repetitions(compiler, length):
+    for expression, expected in [('("a" | "")', True), ('("a" | "aa")', length >= 129)]:
+        ctx = compiler.compile_grammar(f'root ::= {expression}{{129,}} "!"')
+        assert xg.GrammarMatcher(ctx).accept_string("a" * length + "!") == expected
+
+
+@pytest.mark.parametrize("format", ["json", "qwen_xml"])
+@pytest.mark.parametrize("value_keyword", ["additionalProperties", "unevaluatedProperties"])
+def test_undeclared_required_keeps_value_constraints(format, value_keyword):
+    schema = {"type": "object", "required": ["n"], value_keyword: {"type": "integer"}}
+    grammar = _json_schema_to_ebnf(json.dumps(schema), json_format=format)
+    valid = '{"n":7}' if format == "json" else "<parameter=n>7</parameter>"
+    invalid = '{"n":"wrong"}' if format == "json" else "<parameter=n>wrong</parameter>"
+    empty = "{}" if format == "json" else ""
+    assert _is_grammar_accept_string(grammar, valid)
+    assert not _is_grammar_accept_string(grammar, invalid)
+    assert not _is_grammar_accept_string(grammar, empty)
+
+
+@pytest.mark.parametrize("strict_mode", [True, False])
+def test_undeclared_required_without_additional_keyword(strict_mode):
+    schema = {"type": "object", "required": ["n"]}
+    assert accepts(schema, '{"n":null}', strict_mode=strict_mode)
+    assert not accepts(schema, "{}", strict_mode=strict_mode)
+
+
+@pytest.mark.parametrize("extra", [
+    {"additionalProperties": False},
+    {"unevaluatedProperties": False},
+    {"patternProperties": {"^n$": {"type": "integer"}}},
+    {"propertyNames": {"pattern": "^n$"}},
+])
+def test_forbidden_or_unsupported_undeclared_required_fails_closed(extra):
+    with pytest.raises(RuntimeError):
+        xg.Grammar.from_json_schema({"type": "object", "required": ["n"], **extra})
+
+
+def test_empty_xml_yields_to_end_tag_but_json_keeps_whitespace(compiler):
+    schema = {"type": "object", "properties": {}, "additionalProperties": False}
+    grammar = _json_schema_to_ebnf(json.dumps(schema), json_format="qwen_xml")
+    assert _is_grammar_accept_string(grammar, "")
+    assert not _is_grammar_accept_string(grammar, " ")
+    assert not _is_grammar_accept_string(grammar, "\n")
+    assert accepts(schema, "{ \n }")
+    tag = {"type": "structural_tag", "format": {
+        "type": "tag", "begin": "<tool>", "end": "</tool>",
+        "content": {"type": "json_schema", "style": "qwen_xml", "json_schema": schema}}}
+    ctx = compiler.compile_structural_tag(json.dumps(tag))
+    assert xg.GrammarMatcher(ctx).accept_string("<tool></tool>")
+    assert not xg.GrammarMatcher(ctx).accept_string("<tool> \n</tool>")
+
+
+def test_xml_declared_order_and_nested_json_types_are_unchanged():
+    schema = {"type": "object", "properties": {
+        "a": {"type": "integer"},
+        "b": {"type": "object", "properties": {"n": {"const": 7}},
+              "required": ["n"], "additionalProperties": False}},
+        "required": ["a", "b"], "additionalProperties": False}
+    grammar = _json_schema_to_ebnf(json.dumps(schema), json_format="qwen_xml")
+    assert _is_grammar_accept_string(grammar, '<parameter=a>1</parameter><parameter=b>{"n":7}</parameter>')
+    assert not _is_grammar_accept_string(grammar, '<parameter=b>{"n":7}</parameter><parameter=a>1</parameter>')
+    assert not _is_grammar_accept_string(grammar, '<parameter=a>1</parameter><parameter=b>{"n":"7"}</parameter>')
