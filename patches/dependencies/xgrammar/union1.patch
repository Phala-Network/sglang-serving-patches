+"""Installed-library checks; no model downloads or GPU allocation."""
+import json
+
+import pytest
+import torch
+import xgrammar as xg
+
+
+def compiler():
+    return xg.GrammarCompiler(
+        xg.TokenizerInfo([bytes([i]) for i in range(256)] + [b"<eos>"],
+                         xg.VocabType.RAW, stop_token_ids=[256]),
+        max_threads=2,
+    )
+
+
+@pytest.mark.parametrize("value", ["a", "\n", '"', "\\", "\u4e2d", "\U0001f600"])
+@pytest.mark.parametrize("ascii_only", [False, True])
+def test_bounded_decoded_character(value, ascii_only):
+    ctx = compiler().compile_json_schema({"type": "string", "minLength": 1, "maxLength": 1})
+    assert xg.GrammarMatcher(ctx).accept_string(json.dumps(value, ensure_ascii=ascii_only))
+    assert not xg.GrammarMatcher(ctx).accept_string('""')
+    assert not xg.GrammarMatcher(ctx).accept_string(json.dumps(value * 2, ensure_ascii=ascii_only))
+
+
+def test_order_mask_rollback():
+    ctx = compiler().compile_json_schema({
+        "type": "object", "properties": {"a": {"type": "integer"}, "b": {"type": "integer"}},
+        "required": ["a", "b"], "additionalProperties": False,
+    })
+    matcher = xg.GrammarMatcher(ctx)
+    assert matcher.accept_string('{"b":2,')
+    mask = xg.allocate_token_bitmask(1, 257)
+    matcher.fill_next_token_bitmask(mask)
+    before = mask.clone()
+    assert matcher.accept_token(ord('"'))
+    matcher.fill_next_token_bitmask(mask)
+    assert int(mask[0, ord("a") // 32]) & (1 << (ord("a") % 32))
+    assert not (int(mask[0, ord("b") // 32]) & (1 << (ord("b") % 32)))
+    matcher.rollback(1)
+    matcher.fill_next_token_bitmask(mask)
+    assert torch.equal(mask, before)
+    assert matcher.accept_string('"a":1}')
+    assert matcher.accept_token(256)
+    assert matcher.is_terminated()
