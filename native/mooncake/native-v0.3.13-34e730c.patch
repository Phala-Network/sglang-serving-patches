+Capture::Capture() = default;
+Capture::Capture(Config c) : impl_(std::make_unique<Impl>(std::move(c))) {}
+Capture::~Capture() = default;
+bool Capture::Enabled() const noexcept { return impl_ && !impl_->expired.load(); }
+bool Capture::OwnerEnabled() const noexcept {
